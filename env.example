# Environment Variables Example for Docker Deployment
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=trading_user
DB_PASSWORD=password123
DB_NAME=nsedata
DB_TRADING=trading_db

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Environment
ENV=production

# Note: Session timeout is configured in .streamlit/config.toml
# No cookie manager or special environment variables needed for authentication

