# Copy to `.env` and adjust. Used by local `streamlit run` (via load_dotenv) and by docker compose substitution.

# PostgreSQL — align with your FastAPI backend (APP_DB_* connects as the app user)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
APP_DB_USER=trading_user
APP_DB_PASSWORD=change-me
NSE_DATA_DB_NAME=nsedata
TRADING_DB_NAME=trading_db

# Legacy fallbacks (optional): POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DATABASE

# Which Postgres to talk to: `local` or `ec2`. Mirrors falcon_app's DB_TARGET.
#   local -> POSTGRES_HOST:POSTGRES_PORT
#   ec2   -> 127.0.0.1:EC2_DB_TUNNEL_PORT, via the SSM forward started by
#            scripts/run-ec2-db-tunnel.ps1  (see docs/EC2_POSTGRES.md)
# Override per invocation without editing this file:  $env:DB_TARGET = 'ec2'
DB_TARGET=local
EC2_DB_TUNNEL_PORT=15432

# Set these ONLY if the EC2 credentials differ from the local ones above.
# EC2_APP_DB_USER=
# EC2_APP_DB_PASSWORD=
# Connection resilience (optional; defaults shown). These matter most on the ec2
# target, where an idle SSM forward can silently drop a pooled connection.
# POSTGRES_CONNECT_TIMEOUT=10
# POSTGRES_KEEPALIVES_IDLE=30
# POSTGRES_KEEPALIVES_INTERVAL=10
# POSTGRES_KEEPALIVES_COUNT=3
# POSTGRES_SSLMODE=require   # only when reaching Postgres without the SSM tunnel

# Optional: email / scheduling (see pages that use SMTP_*)
# SMTP_SENDER=
# SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SCHEDULE_EMAIL_RECIPIENTS=
